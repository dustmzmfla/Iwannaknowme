import { NextResponse } from "next/server";

/**
 * 카카오 로그인 콜백. 예전엔 여기서 세션 교환 + 프로필 조회까지 다 끝낸 뒤에야
 * 302 리다이렉트를 돌려줬는데, 그 작업(카카오/Supabase 네트워크 왕복 포함)이
 * 1~3초 정도 걸리는 동안 브라우저엔 아무것도 그려지지 않는 새하얀 빈 화면만
 * 떠 있었습니다 — "로그인이 안 되는 것처럼 보인다"는 피드백의 원인이었습니다.
 *
 * 라우트 핸들러는 React를 그릴 수 없어서, 대신 이 GET이 "즉시"(비동기 작업 없이)
 * 눈 두 개가 두리번거리는 로딩 화면을 완성된 HTML로 반환합니다. 실제 세션 교환은
 * 그 화면이 뜬 채로 /api/auth/exchange 에 맡기고, 응답으로 받은 목적지로
 * 클라이언트에서 이동시킵니다.
 */
export async function GET() {
  return new NextResponse(CALLBACK_HTML, {
    headers: { "Content-Type": "text/html; charset=utf-8" },
  });
}

const CALLBACK_HTML = `<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>로그인 확인하는 중</title>
<style>
  html, body {
    margin: 0;
    height: 100%;
    background: #3E3226;
  }
  .overlay {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    background: rgba(62, 50, 38, 0.94);
    font-family: -apple-system, BlinkMacSystemFont, "Noto Sans KR", sans-serif;
  }
  .eyes {
    display: flex;
    align-items: center;
    gap: 12px;
    animation: eyesRow 4.8s ease-in-out infinite;
  }
  .eye {
    width: 36px;
    height: 44px;
    border-radius: 50%;
    background: #FBF4E4;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .eye.left { animation: eyeLeft 4.8s ease-in-out infinite; }
  .eye.right { animation: eyeRight 4.8s ease-in-out infinite; }
  .pupil {
    position: relative;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #3E3226;
    animation: pupil 4.8s ease-in-out infinite;
  }
  .pupil::after {
    content: "";
    position: absolute;
    left: 3px;
    top: 3px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(251, 244, 228, 0.8);
  }
  .msg {
    color: #FBF4E4;
    font-size: 17px;
    letter-spacing: 0.02em;
    margin: 0;
  }
  .dots {
    display: inline-block;
    width: 1.2em;
    text-align: left;
  }
  @keyframes eyesRow {
    0%, 100% { transform: translateX(0); }
    20% { transform: translateX(7px); }
    40% { transform: translateX(0); }
    60% { transform: translateX(-7px); }
    80% { transform: translateX(0); }
  }
  @keyframes eyeLeft {
    0%, 100% { transform: scale(1); }
    20% { transform: scale(0.86); }
    40% { transform: scale(1); }
    60% { transform: scale(1.28); }
    80% { transform: scale(1); }
  }
  @keyframes eyeRight {
    0%, 100% { transform: scale(1); }
    20% { transform: scale(1.28); }
    40% { transform: scale(1); }
    60% { transform: scale(0.86); }
    80% { transform: scale(1); }
  }
  @keyframes pupil {
    0%, 100% { transform: translateX(0); }
    20% { transform: translateX(5px); }
    40% { transform: translateX(0); }
    60% { transform: translateX(-5px); }
    80% { transform: translateX(0); }
  }
</style>
</head>
<body>
  <div class="overlay">
    <div class="eyes">
      <div class="eye left"><div class="pupil"></div></div>
      <div class="eye right"><div class="pupil"></div></div>
    </div>
    <p class="msg">두리번두리번 찾는 중<span class="dots" id="dots"></span></p>
  </div>
  <script>
    (function () {
      var dotsEl = document.getElementById("dots");
      var n = 0;
      setInterval(function () {
        n = (n + 1) % 4;
        dotsEl.textContent = ".".repeat(n);
      }, 1000);

      var params = new URLSearchParams(window.location.search);
      var code = params.get("code");
      var next = params.get("next") || "/";

      if (!code) {
        window.location.replace("/login?error=oauth");
        return;
      }

      fetch("/api/auth/exchange", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ code: code, next: next }),
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          window.location.replace(data.redirectTo || "/login?error=oauth");
        })
        .catch(function () {
          window.location.replace("/login?error=oauth");
        });
    })();
  </script>
</body>
</html>
`;
