# ── 배포 도메인 (ads.txt / sitemap.xml / canonical URL / 카카오 redirect 조합에 사용) ──
NEXT_PUBLIC_SITE_URL=https://your-domain.example.com

# ── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# ⚠️ service role 키는 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── 카카오 로그인 ─────────────────────────────────────────
# Supabase 대시보드 > Authentication > Providers > Kakao 에 REST API 키/Client Secret을 등록하고,
# 카카오 디벨로퍼스 앱의 Redirect URI에는 `${NEXT_PUBLIC_SUPABASE_URL}/auth/v1/callback` 을 등록하세요.

# ── Google AdSense ───────────────────────────────────────
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# ── Google Search Console 소유 확인 (선택) ───────────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
